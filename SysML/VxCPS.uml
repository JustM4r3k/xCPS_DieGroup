    <packagedElement xmi:type="uml:Package" xmi:id="_mZhWgObbEfGP-dqCs_iRcA" name="Parameters">
      <packagedElement xmi:type="uml:Class" xmi:id="_u5ZF0ObbEfGP-dqCs_iRcA" name="BOMCalculation">
        <ownedRule xmi:type="uml:Constraint" xmi:id="_H4-v4ObcEfGP-dqCs_iRcA" name="Constraint5">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="_H4_-AObcEfGP-dqCs_iRcA" name="constraintSpec">
            <language>Natural language</language>
            <body>BOM = Arm + Belt + Table&#xD;
</body>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_7Y4sYObbEfGP-dqCs_iRcA" name="Arm">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Real"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_Dx0tQObcEfGP-dqCs_iRcA" name="Belt">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Real"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_FQJFYObcEfGP-dqCs_iRcA" name="Table">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Real"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_GoexUObcEfGP-dqCs_iRcA" name="BOM">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Real"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_vJIyAObbEfGP-dqCs_iRcA" name="SalesVolume">
        <ownedRule xmi:type="uml:Constraint" xmi:id="_nBk_kObcEfGP-dqCs_iRcA" name="Constraint4">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="_nBk_kebcEfGP-dqCs_iRcA" name="constraintSpec">
            <language>Natural language</language>
            <body>Volume = max(0, 1500 + 2 * (5133.20 - Price) + 25 * (270.96 - M))</body>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_eqYrIObcEfGP-dqCs_iRcA" name="Price">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Real"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_jhjOYObcEfGP-dqCs_iRcA" name="M">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Real"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_lk0tsObcEfGP-dqCs_iRcA" name="Volume">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Real"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_vTKQsObbEfGP-dqCs_iRcA" name="SellingPrice">
        <ownedRule xmi:type="uml:Constraint" xmi:id="_RXQoMObcEfGP-dqCs_iRcA" name="Constraint3">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="_RXRPQObcEfGP-dqCs_iRcA" name="constraintSpec">
            <language>Natural language</language>
            <body>Price = 1.2 * (BOM + 1000)</body>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_OQedcObcEfGP-dqCs_iRcA" name="BOM">
