  <Requirements:Requirement xmi:id="_n22agORGEfGD2PzXPcaESg" base_NamedElement="_n2z-QORGEfGD2PzXPcaESg" base_Class="_n2z-QORGEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_pSWvMORGEfGD2PzXPcaESg" base_NamedElement="_pSTr4ORGEfGD2PzXPcaESg" base_Class="_pSTr4ORGEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_s4gWgORGEfGD2PzXPcaESg" base_NamedElement="_s4dTMORGEfGD2PzXPcaESg" base_Class="_s4dTMORGEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_uzcZMORGEfGD2PzXPcaESg" base_NamedElement="_uzXgsORGEfGD2PzXPcaESg" base_Class="_uzXgsORGEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_wjxHUORGEfGD2PzXPcaESg" base_NamedElement="_wjurEORGEfGD2PzXPcaESg" base_Class="_wjurEORGEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_g-DhQORHEfGD2PzXPcaESg" base_NamedElement="_g9_24ORHEfGD2PzXPcaESg" id="FR-01" text="The system shall assemble a batch of 10 tops and 10 bottoms into 10 products." base_Class="_g9_24ORHEfGD2PzXPcaESg"/>
  <Requirements:DeriveReqt xmi:id="_N7b6AORJEfGD2PzXPcaESg" base_DirectedRelationship="_N7VMUORJEfGD2PzXPcaESg" base_Abstraction="_N7VMUORJEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_6UkysORJEfGD2PzXPcaESg" base_NamedElement="_6UiWcORJEfGD2PzXPcaESg" id="FR-03" text="The system shall take the tops and bottoms from the storage area." base_Class="_6UiWcORJEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_MGFsgORKEfGD2PzXPcaESg" base_NamedElement="_MGDQQORKEfGD2PzXPcaESg" id="FR-04" text="The systems shall transport peices from the input belt through the manufacturing module to the output belt" base_Class="_MGDQQORKEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_axH9kORKEfGD2PzXPcaESg" base_NamedElement="_axE6QORKEfGD2PzXPcaESg" id="FR-05" text="The system shall place each top onto a bottom with the pick-and place unit" base_Class="_axE6QORKEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_xZaZEORKEfGD2PzXPcaESg" base_NamedElement="_xZX80ORKEfGD2PzXPcaESg" id="FR-06" text="The system shall place the 10 products back in the storage area." base_Class="_xZX80ORKEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_8Gg08ORKEfGD2PzXPcaESg" base_NamedElement="_8GdKkORKEfGD2PzXPcaESg" id="FR-07" text="The system shall complete every batch without piece loss or manual/humna intervention" base_Class="_8GdKkORKEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_LHA_sORLEfGD2PzXPcaESg" base_NamedElement="_LG-jcORLEfGD2PzXPcaESg" id="SR-01" text="Pieces shall never collide during transport or assembly" base_Class="_LG-jcORLEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_VhW3oORLEfGD2PzXPcaESg" base_NamedElement="_VhUbYORLEfGD2PzXPcaESg" id="SR-02" text="Pieces shall never fall off a belt" base_Class="_VhUbYORLEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_jl8zwORLEfGD2PzXPcaESg" base_NamedElement="_jl6-kORLEfGD2PzXPcaESg" id="SR-03" text="The turner shall not rotate while a piece is entering or leaving" base_Class="_jl6-kORLEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_4RmjcORLEfGD2PzXPcaESg" base_NamedElement="_4RjgIORLEfGD2PzXPcaESg" id="PR-01" text="The enrgy consumption for producting one batch shall be less than 2.0MJ" base_Class="_4RjgIORLEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_AcKxIORMEfGD2PzXPcaESg" base_NamedElement="_AcI78ORMEfGD2PzXPcaESg" id="PR-02" text="If the selling price is not bellow 5113.2eur the batch makespan (inverted tops, normal bottoms) shall be less than 270.96s" base_Class="_AcI78ORMEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_m4oQAORMEfGD2PzXPcaESg" base_NamedElement="_m4ma0ORMEfGD2PzXPcaESg" base_Class="_m4ma0ORMEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_1voggORMEfGD2PzXPcaESg" base_NamedElement="_1vmEQORMEfGD2PzXPcaESg" id="BR-01" text="The selling price shall be bellow 5113.20eur or the batch makespan shall be bellow 270.96s" base_Class="_1vmEQORMEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_AaJicORNEfGD2PzXPcaESg" base_NamedElement="_AaHtQORNEfGD2PzXPcaESg" id="BR-01.1" text="If the batch makespan is not bellow 270.96s, the BOM shall bebellow 3261eur" base_Class="_AaHtQORNEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_Kuwl0ORNEfGD2PzXPcaESg" base_NamedElement="_KuuJkORNEfGD2PzXPcaESg" id="BR-02" text="The design shall maximise the expected profit, subject to PR-01" base_Class="_KuuJkORNEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_T2b8AORNEfGD2PzXPcaESg" base_NamedElement="_T2ZfwORNEfGD2PzXPcaESg" id="BR-03.1" text="The sales volume shall be computed with the described market module" base_Class="_T2ZfwORNEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_gncwYORNEfGD2PzXPcaESg" base_NamedElement="_gnaUIORNEfGD2PzXPcaESg" id="BR-03.2" text="The selling price shall be 1.2 × (BOM + eur1,000)." base_Class="_gnaUIORNEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_lj8fkORNEfGD2PzXPcaESg" base_NamedElement="_lj6DUORNEfGD2PzXPcaESg" id="BR-03.3" text="Profit shall include NRE (72,000eur application change, 108,000eur platform change) and the time-to-market delay (4 or 8 weeks)." base_Class="_lj6DUORNEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_wnu9IORNEfGD2PzXPcaESg" base_NamedElement="_wnr50ORNEfGD2PzXPcaESg" id="BR-03.4" text="Profit shall be evaluated over a 5-year lifetime at a market entry on 1st of Jully 2027." base_Class="_wnr50ORNEfGD2PzXPcaESg"/>
  <Requirements:DeriveReqt xmi:id="_t_3GgOROEfGD2PzXPcaESg" base_DirectedRelationship="_t_0qQOROEfGD2PzXPcaESg" base_Abstraction="_t_0qQOROEfGD2PzXPcaESg"/>
  <Requirements:DeriveReqt xmi:id="_kfhjQORPEfGD2PzXPcaESg" base_DirectedRelationship="_kfdR0ORPEfGD2PzXPcaESg" base_Abstraction="_kfdR0ORPEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_rhcRYORQEfGD2PzXPcaESg" base_NamedElement="_rhacMORQEfGD2PzXPcaESg" id="CR-01" text="Belts, index table and gantry arms shall be chosen from the slow,, normal and fast variants" base_Class="_rhacMORQEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_yrtfsORQEfGD2PzXPcaESg" base_NamedElement="_yrrDcORQEfGD2PzXPcaESg" id="CR-02" text="The IO module shall have at least one gantry arm" base_Class="_yrrDcORQEfGD2PzXPcaESg"/>
  <Requirements:Requirement xmi:id="_5X5D0ORQEfGD2PzXPcaESg" base_NamedElement="_5X2nkORQEfGD2PzXPcaESg" id="CR-03" text="The machine layout (storage, belts, turner, index table 2, pick-and-place, switches) shall be kept as in the current machine" base_Class="_5X2nkORQEfGD2PzXPcaESg"/>
